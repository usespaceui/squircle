{
  "name": "@usespaceui/squircle",
  "version": "0.1.1",
  "description": "Flawless math-driven squircle masking and geometry rendering for modern UIs.",
  "author": {
    "name": "SpaceUI",
    "email": "hello@spaceui.one",
    "url": "https://www.spaceui.one"
  },
  "contributors": [
    {
      "name": "SpaceUI Team",
      "email": "hello@spaceui.one",
      "url": "https://www.spaceui.one"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/usespaceui"
  },
  "license": "MIT",
  "homepage": "https://squircle.spaceui.one",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usespaceui/squircle.git"
  },
  "bugs": {
    "url": "https://github.com/usespaceui/squircle/issues",
    "email": "hello@spaceui.one"
  },
  "keywords": [
    "react",
    "squircle",
    "css",
    "houdini",
    "geometry",
    "spaceui",
    "corners",
    "smooth"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
